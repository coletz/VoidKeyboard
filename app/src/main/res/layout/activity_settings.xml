<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Grouped list: the backgrounds (rounded outer corners, ripple) are set in SettingsActivity -->
        <LinearLayout
            android:id="@+id/enabled_languages_setting"
            style="@style/SettingsItem">

            <TextView
                style="@style/SettingsItemTitle"
                android:text="@string/enabled_languages_setting" />

            <TextView
                style="@style/SettingsItemSummary"
                android:text="@string/enabled_languages_setting_desc" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/selected_language_setting"
            style="@style/SettingsItem">

            <TextView
                style="@style/SettingsItemTitle"
                android:text="@string/settings_selected_language" />

            <TextView
                android:id="@+id/language_value"
                style="@style/SettingsItemSummary" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/key_navigation_setting"
            style="@style/SettingsItem">

            <TextView
                style="@style/SettingsItemTitle"
                android:text="@string/key_navigation_setting" />

            <TextView
                style="@style/SettingsItemSummary"
                android:text="@string/key_navigation_setting_desc" />

            <TextView
                android:id="@+id/key_navigation_status"
                style="@style/SettingsItemSummary"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorPrimary" />

        </LinearLayout>

        <!-- Only shown when the device's keyboard is touch sensitive (DeviceKeyboard.touchKeyboardDeviceName) -->
        <LinearLayout
            android:id="@+id/touch_keyboard_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/SettingsSectionTitle"
                android:text="@string/touch_keyboard_section" />

            <LinearLayout
                android:id="@+id/cursor_mode_setting"
                style="@style/SettingsSwitchItem">

                <LinearLayout style="@style/SettingsSwitchItemText">

                    <TextView
                        style="@style/SettingsItemTitle"
                        android:text="@string/cursor_mode_setting" />

                    <TextView
                        style="@style/SettingsItemSummary"
                        android:text="@string/cursor_mode_setting_desc" />

                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/cursor_mode_switch"
                    style="@style/SettingsSwitch" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/swipe_to_delete_setting"
                style="@style/SettingsSwitchItem">

                <LinearLayout style="@style/SettingsSwitchItemText">

                    <TextView
                        style="@style/SettingsItemTitle"
                        android:text="@string/swipe_to_delete_setting" />

                    <TextView
                        style="@style/SettingsItemSummary"
                        android:text="@string/swipe_to_delete_setting_desc" />

                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swipe_to_delete_switch"
                    style="@style/SettingsSwitch" />

            </LinearLayout>

        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/test_input_layout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="@string/test_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/test_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="3"
                android:gravity="top|start" />

        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

</ScrollView>
